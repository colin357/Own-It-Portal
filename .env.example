# Firebase web app config (Firebase console → Project settings → General → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account for server-side flows (signup, invites, admin bootstrap).
# Firebase console → Project settings → Service accounts → Generate new private key,
# then base64-encode the JSON file:  base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=

# TEMPORARY pre-launch mode: log in against the old Firestore users/adminUsers
# docs instead of Firebase Authentication. Requires open Firestore rules
# (see firestore-legacy.rules). Set to false (or remove) before go-live.
NEXT_PUBLIC_LEGACY_AUTH=false

# Comma-separated list of agency emails that get the admin role on first login.
ADMIN_EMAILS=colin@ownitsocial.com

# Public URL of the deployed app (used in SMS links). Falls back to the request origin.
NEXT_PUBLIC_APP_URL=

# Twilio — SMS task reminders and invite texts (optional; features no-op without these).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Protects the /api/cron/reminders endpoint. Vercel Cron sends it automatically
# when a CRON_SECRET env var exists on the project.
CRON_SECRET=

# OpenAI — AI content idea generation (optional; the button errors gracefully without it).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
